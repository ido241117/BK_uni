# Application
# Backend API
PORT=3200
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bk_uni
DB_TEST_NAME=bk_uni_test

# Local demo admin seed; use a private value in .env
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=
DEMO_SEED_PASSWORD=

# Swagger
SWAGGER_TITLE=BK Uni API Docs
SWAGGER_DESCRIPTION=BK Uni backend API documentation
SWAGGER_VERSION=1.0

# CORS
# Frontend development server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://bkuni.phanlethien.xyz

# Optional locally; configure a long random value for shared/multi-process deployments.
CSRF_SECRET=