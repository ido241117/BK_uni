# Application
# Let the operating system assign an available port.
PORT=0
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bk_uni

# Swagger
SWAGGER_TITLE=BK Uni API Docs
SWAGGER_DESCRIPTION=BK Uni backend API documentation
SWAGGER_VERSION=1.0

# CORS
# In production, provide exact allowed origins. Development allows localhost on any port.
CORS_ORIGINS=