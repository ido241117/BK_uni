NODE_ENV=development
PORT=3210
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=bk_uni
DB_SCHEMA=public
DB_SSL_MODE=local
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_TTL_SECONDS=86400
CORS_ORIGINS=http://localhost:5173,http://localhost:3210

# Tư vấn với AI (DeepSeek). Bỏ trống DEEPSEEK_API_KEY thì trang Tư vấn với AI báo chưa cấu hình.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# enabled: trả về reasoning_content (hiện ở trajectory); disabled: nhanh và rẻ hơn
DEEPSEEK_THINKING=enabled
# Tùy chọn khi bật thinking, ví dụ high
DEEPSEEK_REASONING_EFFORT=
